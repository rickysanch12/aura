# ALCOS Environment Configuration
# Copy this file to .env and customize for your environment

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Frontend Configuration
FRONTEND_PORT=3000
FRONTEND_DEV_PORT=5173

# Database Configuration
VECTOR_DB_PATH=~/.alcos/memory/chromadb
VECTOR_DB_TYPE=chromadb
VECTOR_DB_DIMENSION=384

# Model Configuration
MODELS_PATH=~/.alcos/models
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=hermes
ENABLE_LOCAL_MODELS=true
ENABLE_CLOUD_MODELS=false

# Agent Configuration
MAX_AGENTS=10
MAX_QUEUE_SIZE=100
AGENT_TIMEOUT=300
AGENT_MEMORY_LIMIT=2048

# GPU Configuration
ENABLE_GPU=true
GPU_DEVICE=cuda:0
GPU_MEMORY_LIMIT=24
TORCH_HOME=~/.alcos/torch

# Memory Configuration
MEMORY_COMPACT_INTERVAL=3600
MEMORY_CLEANUP_THRESHOLD=0.8
MEMORY_AUTO_SAVE=true
MEMORY_SAVE_INTERVAL=300

# Code Execution Configuration
ENABLE_CODE_EXECUTION=true
SANDBOX_TYPE=docker
SANDBOX_TIMEOUT=30
CODE_EXECUTION_MEMORY_LIMIT=512

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=~/.alcos/logs/alcos.log
LOG_RETENTION_DAYS=30
LOG_MAX_SIZE_MB=100

# Security Configuration
ENABLE_AUTH=false
API_KEY=your-secure-api-key-here
CORS_ORIGINS=localhost:3000,localhost:5173

# LiteLLM Configuration (for cloud models)
LITELLM_LOG=false
LITELLM_CACHE=false

# Monitoring Configuration
ENABLE_MONITORING=true
MONITORING_INTERVAL=60
METRICS_PORT=9090

# Development Configuration
DEBUG=false
DEV_MODE=false
RELOAD_ON_CHANGE=true

# Persistence Configuration
PERSIST_STATE=true
STATE_PATH=~/.alcos/state
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400
